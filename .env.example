# ---------------------------------------------------------------
# Copy this file to  .env  and paste your real key after the =
# .env is git-ignored and never served by the web server.
# ---------------------------------------------------------------

# ElevenLabs — voice (required for server-side speech)
ELEVENLABS_API_KEY=sk_paste_your_key_here
# optional: pick a voice from your library (default = George)
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# eleven_v4_turbo (~100ms, 90+ langs) | eleven_flash_v2_5 (~75ms, 32 langs)
ELEVENLABS_MODEL=eleven_v4_turbo

# Brain (optional — leave both blank to use local rules)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Port
PORT=8787
